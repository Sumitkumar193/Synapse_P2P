{
  "name": "electron-p2p-media-sdk",
  "version": "1.0.0",
  "description": "Production-grade Electron P2P Media SDK and Application",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "setup:install": "npm install && tsx scripts/setup-whisper.ts",
    "build:portable": "tsx scripts/build-portable.ts",
    "build:installer": "tsx scripts/build-installer.ts",
    "dev": "cross-env NODE_ENV=development tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=development electron .",
    "test": "tsx test/index.ts",
    "clean": "rimraf dist release"
  },
  "keywords": [
    "electron",
    "webrtc",
    "p2p",
    "screen-share",
    "media-sdk",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "adm-zip": "^0.5.10",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.synapse.p2pscreenshare",
    "productName": "P2PScreenShare",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "vendor/whisper/bin/**/*",
      "!vendor/whisper/models/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
